#!/bin/sh
# RPCD backend plugin for luci-app-headscale
# Copyright (C) 2026 permails <logo@permails.com>
#
# This is free software, licensed under the Apache License, Version 2.0.
#

. /usr/share/libubox/jshn.sh

HEADSCALE_BIN="/usr/bin/headscale"
CONFIG_PATH="/var/etc/headscale/config.yaml"
ACL_PATH="/etc/headscale/acl.hujson"
LOG_DIR="/var/log/headscale"

run_headscale() {
	pid=$(pidof headscale)
	[ -z "$pid" ] && return 1
	if [ -f "$CONFIG_PATH" ]; then
		timeout -s 9 2 "$HEADSCALE_BIN" -c "$CONFIG_PATH" "$@"
	else
		timeout -s 9 2 "$HEADSCALE_BIN" "$@"
	fi
}

case "$1" in
	list)
		echo '{
			"get_status": {},
			"list_nodes": {},
			"delete_node": { "id": 0 },
			"expire_node": { "id": 0 },
			"rename_node": { "id": 0, "name": "" },
			"approve_routes": { "id": 0, "routes": "" },
			"list_users": {},
			"create_user": { "name": "" },
			"delete_user": { "name": "" },
			"list_preauthkeys": { "user_name": "" },
			"create_preauthkey": { "user_name": "" },
			"expire_preauthkey": { "user_name": "", "key": "" },
			"get_acl": {},
			"set_acl": { "content": "" },
			"clean_acl_staging": {},
			"clear_staging": { "scope": "" },
			"get_log": { "lines": 0 },
			"clean_log": {},
			"get_firewall_status": {},
			"set_firewall": { "enabled": false, "port": "", "stun_port": "" },
			"service_action": { "action": "" },
			"detect_certs": {}
		}'
	;;
	call)
		case "$2" in
			detect_certs)
				cert=""
				key=""
				cert_type="none"

				if [ -f "/etc/uhttpd.crt" ] && [ -f "/etc/uhttpd.key" ]; then
					cert="/etc/uhttpd.crt"
					key="/etc/uhttpd.key"
					cert_type="uhttpd"
				elif [ -f "/etc/ssl/uhttpd.crt" ] && [ -f "/etc/ssl/uhttpd.key" ]; then
					cert="/etc/ssl/uhttpd.crt"
					key="/etc/ssl/uhttpd.key"
					cert_type="uhttpd"
				elif [ -f "/etc/nginx/conf.d/_lan.crt" ] && [ -f "/etc/nginx/conf.d/_lan.key" ]; then
					cert="/etc/nginx/conf.d/_lan.crt"
					key="/etc/nginx/conf.d/_lan.key"
					cert_type="nginx"
				elif [ -f "/etc/headscale/tls.crt" ] && [ -f "/etc/headscale/tls.key" ]; then
					cert="/etc/headscale/tls.crt"
					key="/etc/headscale/tls.key"
					cert_type="selfsigned"
				fi

				cert_domain=""
				if [ -n "$cert" ] && [ -f "$cert" ] && command -v openssl >/dev/null 2>&1; then
					cert_domain=$(openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null | grep -o 'DNS:[^, ]*' | sed 's/DNS://g' | head -n 1)
					if [ -z "$cert_domain" ]; then
						cert_domain=$(openssl x509 -in "$cert" -noout -subject 2>/dev/null | sed -n 's/.*CN[ ]*=[ ]*//p' | cut -d',' -f1 | cut -d'/' -f1 | tr -d ' ')
					fi
					case "$cert_domain" in
						""|localhost|OpenWrt|127.0.0.1|192.168.*) cert_domain="" ;;
					esac
				fi

				json_init
				json_add_boolean found "$([ -n "$cert" ] && echo 1 || echo 0)"
				json_add_string type "$cert_type"
				json_add_string cert "$cert"
				json_add_string key "$key"
				json_add_string domain "$cert_domain"
				json_dump
				json_cleanup
			;;
			get_status)
				running=0
				pid=$(pidof headscale)
				[ -n "$pid" ] && running=1

				enabled=$(uci -q get headscale.server.enabled)
				[ -z "$enabled" ] && enabled="0"

				version=""
				if [ -x "$HEADSCALE_BIN" ]; then
					pkg_ver=$(apk info headscale 2>/dev/null | head -n 1 | cut -d' ' -f1)
					[ -z "$pkg_ver" ] && pkg_ver=$(opkg status headscale 2>/dev/null | grep Version | cut -d' ' -f2)
					[ -z "$pkg_ver" ] && pkg_ver=$("$HEADSCALE_BIN" version 2>/dev/null | head -n 1)
					version="$pkg_ver"
				fi

				lan_ip=$(uci -q get network.lan.ipaddr)
				[ -z "$lan_ip" ] && lan_ip=$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
				[ -z "$lan_ip" ] && lan_ip="192.168.1.1"
				lan_ip=${lan_ip%%/*}

				wan_ip=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
				wan_ip=${wan_ip%%/*}

				# Detect cert domain
				cert_domain=""
				custom_cert=$(uci -q get headscale.server.tls_cert_path)
				[ -z "$custom_cert" ] && custom_cert="/etc/headscale/tls.crt"
				[ ! -f "$custom_cert" ] && custom_cert="/etc/uhttpd.crt"
				[ ! -f "$custom_cert" ] && custom_cert="/etc/ssl/uhttpd.crt"
				if [ -f "$custom_cert" ] && command -v openssl >/dev/null 2>&1; then
					cert_domain=$(openssl x509 -in "$custom_cert" -noout -ext subjectAltName 2>/dev/null | grep -o 'DNS:[^, ]*' | sed 's/DNS://g' | head -n 1)
					if [ -z "$cert_domain" ]; then
						cert_domain=$(openssl x509 -in "$custom_cert" -noout -subject 2>/dev/null | sed -n 's/.*CN[ ]*=[ ]*//p' | cut -d',' -f1 | cut -d'/' -f1 | tr -d ' ')
					fi
					case "$cert_domain" in
						""|localhost|OpenWrt|127.0.0.1|192.168.*) cert_domain="" ;;
					esac
				fi

				json_init
				json_add_boolean running "$running"
				json_add_boolean enabled "$([ "$enabled" = "1" ] && echo 1 || echo 0)"
				json_add_string pid "$pid"
				json_add_string version "$version"
				json_add_string lan_ip "$lan_ip"
				json_add_string wan_ip "$wan_ip"
				json_add_string cert_domain "$cert_domain"
				json_dump
				json_cleanup
			;;

			service_action)
				read -r input
				json_load "$input"
				json_get_var act action
				case "$act" in
					start)
						uci set headscale.server.enabled=1
						uci commit headscale
						/etc/init.d/headscale enable 2>/dev/null
						/etc/init.d/headscale restart 2>&1
					;;
					stop)
						uci set headscale.server.enabled=0
						uci commit headscale
						/etc/init.d/headscale disable 2>/dev/null
						/etc/init.d/headscale stop 2>&1
						killall headscale 2>/dev/null
					;;
					restart)
						uci set headscale.server.enabled=1
						uci commit headscale
						/etc/init.d/headscale restart 2>&1
					;;
				esac
				echo '{"code": 0}'
			;;

			list_nodes)
				output=$(run_headscale nodes list -o json 2>/dev/null)
				if [ -z "$output" ] || [ "$output" = "null" ] || echo "$output" | grep -q 'error'; then
					output="[]"
				fi
				echo "{\"nodes\": $output}"
			;;

			delete_node)
				read -r input
				json_load "$input"
				json_get_var node_id id
				if [ -n "$node_id" ]; then
					out=$(run_headscale nodes delete -i "$node_id" --force 2>&1)
					rc=$?
					json_init
					json_add_int code "$rc"
					json_add_string message "$out"
					json_dump
					json_cleanup
				else
					echo '{"code": 1, "message": "Missing node id"}'
				fi
			;;

			expire_node)
				read -r input
				json_load "$input"
				json_get_var node_id id
				if [ -n "$node_id" ]; then
					out=$(run_headscale nodes expire -i "$node_id" 2>&1)
					rc=$?
					json_init
					json_add_int code "$rc"
					json_add_string message "$out"
					json_dump
					json_cleanup
				else
					echo '{"code": 1, "message": "Missing node id"}'
				fi
			;;

			rename_node)
				read -r input
				json_load "$input"
				json_get_var node_id id
				json_get_var new_name name
				if [ -n "$node_id" ] && [ -n "$new_name" ]; then
					out=$(run_headscale nodes rename -i "$node_id" "$new_name" 2>&1)
					rc=$?
					json_init
					json_add_int code "$rc"
					json_add_string message "$out"
					json_dump
					json_cleanup
				else
					echo '{"code": 1, "message": "Missing arguments"}'
				fi
			;;

			approve_routes)
				read -r input
				json_load "$input"
				json_get_var node_id id
				json_get_var routes routes
				if [ -n "$node_id" ]; then
					out=$(run_headscale nodes routes set -i "$node_id" -a "$routes" 2>&1)
					rc=$?
					json_init
					json_add_int code "$rc"
					json_add_string message "$out"
					json_dump
					json_cleanup
				else
					echo '{"code": 1, "message": "Missing node id"}'
				fi
			;;

			list_users)
				pid=$(pidof headscale)
				if [ -z "$pid" ]; then
					echo '{"users": []}'
				else
					output=$(run_headscale users list -o json 2>/dev/null)
					if [ -z "$output" ] || [ "$output" = "null" ]; then
						output=$(run_headscale namespaces list -o json 2>/dev/null)
					fi
					if [ -z "$output" ] || [ "$output" = "null" ]; then
						output="[]"
					fi
					echo "{\"users\": $output}"
				fi
			;;

			create_user)
				read -r input
				json_load "$input"
				json_get_var name name
				if [ -n "$name" ]; then
					pid=$(pidof headscale)
					if [ -z "$pid" ]; then
						echo '{"code": 1, "message": "Headscale service is stopped. Please start the service first."}'
					else
						out=$(run_headscale users create "$name" 2>&1)
						rc=$?
						json_init
						json_add_int code "$rc"
						json_add_string message "$out"
						json_dump
						json_cleanup
					fi
				else
					echo '{"code": 1, "message": "Missing username"}'
				fi
			;;

			delete_user)
				read -r input
				json_load "$input"
				json_get_var name name
				[ -z "$name" ] && json_get_var name user
				if [ -n "$name" ]; then
					pid=$(pidof headscale)
					if [ -z "$pid" ]; then
						echo '{"code": 1, "message": "Headscale service is stopped. Please start the service first."}'
					else
						out=$(run_headscale users destroy --name "$name" --force 2>&1)
						rc=$?
						if [ "$rc" -ne 0 ]; then
							out=$(run_headscale users delete --name "$name" --force 2>&1)
							rc=$?
						fi
						if [ "$rc" -ne 0 ]; then
							out=$(run_headscale users destroy "$name" --force 2>&1)
							rc=$?
						fi
						json_init
						json_add_int code "$rc"
						json_add_string message "$out"
						json_dump
						json_cleanup
					fi
				else
					echo '{"code": 1, "message": "Missing username"}'
				fi
			;;

			list_preauthkeys)
				read -r input
				json_load "$input"
				json_get_var user_name user_name
				[ -z "$user_name" ] && json_get_var user_name user
				[ -z "$user_name" ] && json_get_var user_name name
				pid=$(pidof headscale)
				if [ -z "$pid" ]; then
					output="[]"
				else
					output=$(run_headscale preauthkeys list -o json 2>/dev/null)
					if [ -z "$output" ] || [ "$output" = "null" ] || echo "$output" | grep -q 'error'; then
						if [ -n "$user_name" ]; then
							output=$(run_headscale preauthkeys list -u "$user_name" -o json 2>/dev/null)
						fi
					fi
				fi
				if [ -z "$output" ] || [ "$output" = "null" ] || echo "$output" | grep -q 'error'; then
					output="[]"
				fi

				VAULT_FILE="/etc/headscale/vault.db"
				if [ -f "$VAULT_FILE" ] && [ "$output" != "[]" ]; then
					output=$(echo "$output" | awk '
					BEGIN {
						cnt = 0;
						while ((getline line < "'"$VAULT_FILE"'") > 0) {
							if (line != "") {
								vault_keys[cnt++] = line;
							}
						}
						close("'"$VAULT_FILE"'");
					}
					{
						for (i = 0; i < cnt; i++) {
							fk = vault_keys[i];
							pfx = substr(fk, 1, 23);
							target = "\"key\": \"" pfx "-***\"";
							idx = index($0, target);
							if (idx > 0) {
								repl = "\"key\": \"" pfx "-***\", \"full_key\": \"" fk "\"";
								$0 = substr($0, 1, idx - 1) repl substr($0, idx + length(target));
							}
						}
						print $0;
					}
					')
				fi

				echo "{\"keys\": $output}"
			;;

			create_preauthkey)
				read -r input
				json_load "$input"
				json_get_var user_name user_name
				[ -z "$user_name" ] && json_get_var user_name user
				[ -z "$user_name" ] && json_get_var user_name name
				json_get_var reusable reusable
				json_get_var ephemeral ephemeral
				json_get_var expiration expiration

				if [ -n "$user_name" ]; then
					# 优先通过用户名查找对应的 ID
					uid=$(run_headscale users list -o json 2>/dev/null | jsonfilter -e "@[@.name='$user_name'].id" 2>/dev/null)
					# 如果按用户名没找到，再看它本身是不是合法的用户 ID
					if [ -z "$uid" ]; then
						if echo "$user_name" | grep -q '^[0-9]\+$'; then
							check_uid=$(run_headscale users list -o json 2>/dev/null | jsonfilter -e "@[@.id=$user_name].id" 2>/dev/null)
							[ -n "$check_uid" ] && uid="$check_uid"
						fi
					fi

					if [ -n "$uid" ]; then
						cmd="$HEADSCALE_BIN -c $CONFIG_PATH preauthkeys create -u $uid"
						[ "$reusable" = "1" ] || [ "$reusable" = "true" ] && cmd="$cmd --reusable"
						[ "$ephemeral" = "1" ] || [ "$ephemeral" = "true" ] && cmd="$cmd --ephemeral"
						[ -n "$expiration" ] && cmd="$cmd --expiration $expiration"

						out=$($cmd 2>&1)
						rc=$?
						# 提取纯 key (以 hskey- 开头)
						generated_key=$(echo "$out" | grep -o 'hskey-[A-Za-z0-9_-]\+' | head -n 1)
						[ -z "$generated_key" ] && generated_key="$out"

						# 保存到本地 Vault
						if [ "$rc" -eq 0 ] && [ -n "$generated_key" ]; then
							mkdir -p /etc/headscale
							echo "$generated_key" >> /etc/headscale/vault.db
						fi

						json_init
						json_add_int code "$rc"
						json_add_string key "$generated_key"
						json_add_string full_key "$generated_key"
						json_add_string output "$generated_key"
						json_dump
						json_cleanup
					else
						echo "{\"code\": 1, \"message\": \"User not found: $user_name\"}"
					fi
				else
					echo '{"code": 1, "message": "Missing user name"}'
				fi
			;;

			expire_preauthkey)
				read -r input
				json_load "$input"
				json_get_var user_name user_name
				[ -z "$user_name" ] && json_get_var user_name user
				[ -z "$user_name" ] && json_get_var user_name name
				json_get_var key_val key
				json_get_var key_id id
				kid="$key_id"
				[ -z "$kid" ] && kid="$key_val"

				if [ -n "$kid" ]; then
					if ! echo "$kid" | grep -q '^[0-9]\+$'; then
						[ -n "$user_name" ] && kid=$(run_headscale preauthkeys list -u "$user_name" -o json 2>/dev/null | jsonfilter -e "@[@.key='$key_val'].id" 2>/dev/null)
						[ -z "$kid" ] && kid=$(run_headscale preauthkeys list -o json 2>/dev/null | jsonfilter -e "@[@.key='$key_val'].id" 2>/dev/null)
					fi

					if echo "$kid" | grep -q '^[0-9]\+$'; then
						out=$(run_headscale preauthkeys expire -i "$kid" --force 2>&1)
						rc=$?
					else
						out="Key numeric ID could not be determined: $key_val"
						rc=1
					fi

					json_init
					json_add_int code "$rc"
					json_add_string message "$out"
					json_dump
					json_cleanup
				else
					echo '{"code": 1, "message": "Missing key or id argument"}'
				fi
			;;

			get_acl)
				content=""
				if [ -f "$ACL_PATH" ]; then
					content=$(cat "$ACL_PATH")
				fi
				json_init
				json_add_string content "$content"
				json_dump
				json_cleanup
			;;

			set_acl)
				read -r input
				json_load "$input"
				json_get_var content content
				if [ -n "$content" ]; then
					tmp_acl="/tmp/headscale_acl_staging.$$.hujson"
					mkdir -p "$(dirname "$ACL_PATH")"
					echo "$content" > "$tmp_acl"

					# 如果 Headscale 正在运行，使用官方 policy check 命令进行原子预校验
					pid=$(pidof headscale)
					if [ -n "$pid" ] && [ -x "$HEADSCALE_BIN" ]; then
						check_out=""
						if [ -f "$CONFIG_PATH" ]; then
							check_out=$("$HEADSCALE_BIN" -c "$CONFIG_PATH" policy check -f "$tmp_acl" 2>&1)
						else
							check_out=$("$HEADSCALE_BIN" policy check -f "$tmp_acl" 2>&1)
						fi
						check_rc=$?

						if [ $check_rc -ne 0 ]; then
							rm -f "$tmp_acl"
							# 提取精炼的报错信息
							clean_msg=$(echo "$check_out" | grep -iE 'error|invalid|parsing' | head -n 2 | tr '\n' ' ' | sed 's/"/\\"/g')
							[ -z "$clean_msg" ] && clean_msg="策略语法校验失败"
							json_init
							json_add_int code 1
							json_add_string message "$clean_msg"
							json_dump
							json_cleanup
							exit 0
						fi
					fi

					# 校验通过，原子替换目标文件
					mv -f "$tmp_acl" "$ACL_PATH"
					# Stage a delete for the temporary _acl_content staging option
					# so the standard "uci apply" resolves set+delete to a no-op
					# and the option never lands in /etc/config/headscale.
					uci -q delete headscale.server._acl_content
					pid=$(pidof headscale 2>/dev/null)
					[ -n "$pid" ] && kill -HUP "$pid" 2>/dev/null
					json_init
					json_add_int code 0
					json_add_string message "ACL saved successfully"
					json_dump
					json_cleanup
				else
					echo '{"code": 1, "message": "Empty content"}'
				fi
			;;

			clean_acl_staging)
				# Drop the staging-only _acl_content option that the standard
				# uci apply committed into /etc/config/headscale, keeping the
				# base config tidy and leaving no pending delta behind.
				uci -q delete headscale.server._acl_content
				uci -q commit headscale
				echo '{"code": 0, "message": "staging cleaned"}'
			;;

			clear_staging)
				# Remove staging-only options from the pending uci delta.
				# The browser-side uci.unset() is a no-op for options that
				# only exist in the staging delta (never committed), so the
				# views call this to undo a staged operation. Scope selects
				# the page; an empty scope clears all of them.
				read -r input
				json_load "$input"
				json_get_var scope scope
				if [ "$scope" = "users" ]; then
					uci -q delete headscale.server._users_pending
				elif [ "$scope" = "preauthkeys" ]; then
					uci -q delete headscale.server._preauthkeys_pending
				elif [ "$scope" = "acl" ]; then
					uci -q delete headscale.server._acl_content
				else
					uci -q delete headscale.server._users_pending
					uci -q delete headscale.server._preauthkeys_pending
					uci -q delete headscale.server._acl_content
				fi
				echo '{"code": 0, "message": "staging cleared"}'
			;;

			get_log)
				read -r input
				json_load "$input"
				json_get_var lines lines
				[ -z "$lines" ] || [ "$lines" -le 0 ] && lines=200

				log_data=""
				if [ -f /var/log/headscale/headscale.log ] && [ -s /var/log/headscale/headscale.log ]; then
					# The file contains nothing but headscale output (written by
					# the init script), so no content filtering is needed.
					log_data=$(tail -n "$lines" /var/log/headscale/headscale.log 2>/dev/null)
				fi

				if [ -z "$log_data" ] && command -v logread >/dev/null 2>&1; then
					log_data=$(logread 2>/dev/null | grep -i 'headscale\[' | tail -n "$lines")
					if [ -z "$log_data" ]; then
						log_data=$(logread -e headscale -l "$lines" 2>/dev/null | grep -i 'headscale')
					fi
				fi

				if [ -z "$log_data" ]; then
					log_data=$(dmesg 2>/dev/null | grep -i headscale | tail -n "$lines")
				fi

				# Clean duplicate syslog timestamp prefix and format date
				if [ -n "$log_data" ]; then
					log_data=$(echo "$log_data" | sed -E 's/^[A-Za-z0-9: ]+ daemon\.[a-z]+ headscale\[[0-9]+\]: //; s/^([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2}:[0-9]{2}:[0-9]{2})Z/\1 \2/')
				fi

				json_init
				json_add_string log "$log_data"
				json_dump
				json_cleanup
			;;

			clean_log)
				if [ -d /var/log/headscale ]; then
					rm -f /var/log/headscale/*.log
					touch /var/log/headscale/headscale.log
				fi
				json_init
				json_add_int code 0
				json_add_string message "Log cleared successfully"
				json_dump
				json_cleanup
			;;

			get_firewall_status)
				listen_addr=$(uci -q get headscale.server.listen_addr)
				[ -z "$listen_addr" ] && listen_addr="0.0.0.0:8188"
				port=$(echo "$listen_addr" | awk -F: '{print $NF}')
				[ -z "$port" ] && port="8188"

				derp_enabled=$(uci -q get headscale.derp.embedded_enabled)
				[ -z "$derp_enabled" ] && derp_enabled="0"
				stun_addr=$(uci -q get headscale.derp.stun_listen_addr)
				stun_port="3478"
				[ -n "$stun_addr" ] && stun_port=$(echo "$stun_addr" | awk -F: '{print $NF}')

				open_cfg=$(uci -q get headscale.server.open_firewall)

				# 1. Check UCI rule for Headscale TCP port
				fw_dest_port=$(uci -q get firewall.headscale.dest_port)
				fw_enabled=$(uci -q get firewall.headscale.enabled)
				fw_rule_found=0
				if [ -n "$fw_dest_port" ]; then
					# If enabled option is omitted in UCI, it defaults to 1
					[ -z "$fw_enabled" ] && fw_enabled="1"
					[ "$fw_enabled" = "1" ] && fw_rule_found=1
				else
					# Search named or anonymous Allow-Headscale rule
					for s in $(uci show firewall 2>/dev/null | grep -E "\.name='?Allow-Headscale'?" | cut -d. -f2 | sort -u); do
						p=$(uci -q get "firewall.$s.dest_port")
						e=$(uci -q get "firewall.$s.enabled")
						[ -z "$e" ] && e="1"
						if [ -n "$p" ] && [ "$e" = "1" ]; then
							fw_dest_port="$p"
							fw_rule_found=1
							break
						fi
					done
				fi

				# 2. Check UCI rule for STUN UDP port
				stun_rule_found=0
				stun_fw_dest_port=$(uci -q get firewall.headscale_stun.dest_port)
				stun_fw_enabled=$(uci -q get firewall.headscale_stun.enabled)
				if [ -n "$stun_fw_dest_port" ]; then
					[ -z "$stun_fw_enabled" ] && stun_fw_enabled="1"
					[ "$stun_fw_enabled" = "1" ] && stun_rule_found=1
				else
					for s in $(uci show firewall 2>/dev/null | grep -E "\.name='?Allow-Headscale-STUN'?" | cut -d. -f2 | sort -u); do
						p=$(uci -q get "firewall.$s.dest_port")
						e=$(uci -q get "firewall.$s.enabled")
						[ -z "$e" ] && e="1"
						if [ -n "$p" ] && [ "$e" = "1" ]; then
							stun_fw_dest_port="$p"
							stun_rule_found=1
							break
						fi
					done
				fi

				# 3. Live Packet Filter Verification (fw4 nftables / fw3 iptables)
				live_active=0
				live_type="none"
				if command -v nft >/dev/null 2>&1; then
					live_type="fw4 (nftables)"
					if nft list chain inet fw4 input_wan 2>/dev/null | grep -qE "(dport $port|Allow-Headscale)"; then
						live_active=1
					elif nft list ruleset 2>/dev/null | grep -qE "(Allow-Headscale|dport $port.*accept)"; then
						live_active=1
					fi
				elif command -v iptables >/dev/null 2>&1; then
					live_type="fw3 (iptables)"
					if iptables -nL zone_wan_input 2>/dev/null | grep -q "$port" || iptables -nL input_wan_rule 2>/dev/null | grep -q "$port"; then
						live_active=1
					fi
				fi

				# Determine overall opened state
				opened=0
				if [ "$fw_rule_found" = "1" ] || [ "$open_cfg" = "1" ] || [ "$live_active" = "1" ]; then
					opened=1
				fi

				synced=1
				if [ "$opened" = "1" ]; then
					if [ -n "$fw_dest_port" ] && [ "$fw_dest_port" != "$port" ]; then
						synced=0
					fi
				fi

				json_init
				json_add_boolean opened "$opened"
				json_add_string port "$port"
				json_add_string dest_port "$fw_dest_port"
				json_add_boolean derp_enabled "$([ "$derp_enabled" = "1" ] && echo 1 || echo 0)"
				json_add_string stun_port "$stun_port"
				json_add_boolean stun_opened "$stun_rule_found"
				json_add_boolean live_active "$live_active"
				json_add_string live_type "$live_type"
				json_add_boolean synced "$synced"
				json_dump
				json_cleanup
			;;

			set_firewall)
				read -r input
				json_load "$input"
				json_get_var enable enabled
				json_get_var custom_port port
				json_get_var custom_stun_port stun_port

				listen_addr=$(uci -q get headscale.server.listen_addr)
				[ -z "$listen_addr" ] && listen_addr="0.0.0.0:8188"
				port=$(echo "$listen_addr" | awk -F: '{print $NF}')
				[ -z "$port" ] && port="8188"
				[ -n "$custom_port" ] && port="$custom_port"

				derp_enabled=$(uci -q get headscale.derp.embedded_enabled)
				[ -z "$derp_enabled" ] && derp_enabled="0"
				stun_addr=$(uci -q get headscale.derp.stun_listen_addr)
				stun_port="3478"
				[ -n "$stun_addr" ] && stun_port=$(echo "$stun_addr" | awk -F: '{print $NF}')
				[ -n "$custom_stun_port" ] && stun_port="$custom_stun_port"

				clean_headscale_fw_rules() {
					uci -q delete firewall.headscale
					uci -q delete firewall.headscale_stun
					for s in $(uci show firewall 2>/dev/null | grep -E "\.name='?Allow-Headscale(-STUN)?'?" | cut -d. -f2 | sort -u); do
						uci -q delete "firewall.$s"
					done
				}

				if [ "$enable" = "1" ] || [ "$enable" = "true" ]; then
					clean_headscale_fw_rules
					uci set firewall.headscale=rule
					uci set firewall.headscale.name='Allow-Headscale'
					uci set firewall.headscale.src='wan'
					uci set firewall.headscale.proto='tcp'
					uci set firewall.headscale.dest_port="$port"
					uci set firewall.headscale.target='ACCEPT'
					uci set firewall.headscale.enabled='1'

					if [ "$derp_enabled" = "1" ]; then
						uci set firewall.headscale_stun=rule
						uci set firewall.headscale_stun.name='Allow-Headscale-STUN'
						uci set firewall.headscale_stun.src='wan'
						uci set firewall.headscale_stun.proto='udp'
						uci set firewall.headscale_stun.dest_port="$stun_port"
						uci set firewall.headscale_stun.target='ACCEPT'
						uci set firewall.headscale_stun.enabled='1'
					fi

					uci commit firewall
					uci -q set headscale.server.open_firewall='1'
					uci commit headscale

					if [ -x "/etc/init.d/firewall" ]; then
						/etc/init.d/firewall reload >/dev/null 2>&1 || /etc/init.d/firewall restart >/dev/null 2>&1
					elif [ -x "/sbin/fw4" ]; then
						/sbin/fw4 reload >/dev/null 2>&1
					elif [ -x "/sbin/fw3" ]; then
						/sbin/fw3 reload >/dev/null 2>&1
					fi

					if [ "$derp_enabled" = "1" ]; then
						out="Firewall rules successfully applied: WAN TCP $port and UDP $stun_port (STUN) are open"
					else
						out="Firewall rule successfully applied: WAN TCP $port is open"
					fi
				else
					clean_headscale_fw_rules
					uci commit firewall
					uci -q set headscale.server.open_firewall='0'
					uci commit headscale

					if [ -x "/etc/init.d/firewall" ]; then
						/etc/init.d/firewall reload >/dev/null 2>&1 || /etc/init.d/firewall restart >/dev/null 2>&1
					elif [ -x "/sbin/fw4" ]; then
						/sbin/fw4 reload >/dev/null 2>&1
					elif [ -x "/sbin/fw3" ]; then
						/sbin/fw3 reload >/dev/null 2>&1
					fi
					out="Firewall rules removed: External access is completely blocked"
				fi

				json_init
				json_add_int code 0
				json_add_string message "$out"
				json_dump
				json_cleanup
			;;

			*)
				echo '{"error": "Method not found"}'
			;;
		esac
	;;
esac
