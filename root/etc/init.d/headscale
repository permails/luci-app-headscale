#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenWrt.org

START=90
STOP=10

USE_PROCD=1
PROG=/usr/bin/headscale
CONF_SCRIPT=/usr/share/headscale/headscale.sh
CONF_FILE=/var/etc/headscale/config.yaml
LOG_FILE=/var/log/headscale/headscale.log

start_service() {
	local enabled

	config_load headscale
	config_get_bool enabled server enabled 0

	[ "$enabled" -eq 1 ] || return 0

	# Generate config.yaml
	if [ -x "$CONF_SCRIPT" ]; then
		"$CONF_SCRIPT" || return 1
	fi

	[ -f "$CONF_FILE" ] || return 1

	# Persistent daemon log for the LuCI "Log" page. Headscale only writes
	# to stdout/stderr and the syslog ring buffer (logd) is small and gets
	# flooded by other daemons, so redirect the daemon output into a
	# dedicated file which rpcd get_log() reads as its primary source.
	mkdir -p "${LOG_FILE%/*}"
	# /var is tmpfs: cap the file on every start (keep the newest 256 KiB
	# once it grew past 512 KiB) so long uptimes cannot exhaust RAM.
	if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt 524288 ]; then
		tail -c 262144 "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
	fi

	procd_open_instance headscale
	procd_set_param command /bin/sh -c "exec '$PROG' serve -c '$CONF_FILE' >> '$LOG_FILE' 2>&1"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param file /etc/config/headscale
	procd_set_param limits core="unlimited"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "headscale"
}

reload_service() {
	# The standard "uci apply" flow commits the temporary staging options
	# (_acl_content, _users_pending, _preauthkeys_pending) into the base
	# config. Delete them here (the reload is triggered right after the
	# apply commit) so /etc/config/headscale stays clean; the commit below
	# also consumes the pending delta entries.
	uci -q delete headscale.server._acl_content
	uci -q delete headscale.server._users_pending
	uci -q delete headscale.server._preauthkeys_pending

	# Legacy per-item staging options from earlier releases
	# (_add_user_*, _del_user_*, _add_key_*, _del_key_*).
	for opt in $(uci -q show headscale.server 2>/dev/null | awk -F. '/^headscale\.server\._(add|del)_(user|key)_/ { split($3, a, "="); print a[1] }'); do
		uci -q delete headscale.server."$opt"
	done

	uci -q commit headscale

	stop
	start
}
